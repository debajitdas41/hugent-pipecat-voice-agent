# Sarvam AI API Key (required)
SARVAM_API_KEY=

# Backend API (Backend_saas)
BACKEND_API_BASE_URL=http://localhost:8000

# Clinic defaults (for testing)
DEFAULT_CLINIC_ID=clinic_001
DEFAULT_PHONE=+919999999999

# Server configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=19200

# Logging
LOG_LEVEL=INFO

# Audio sample rates (must match client and service expectations)
TTS_SAMPLE_RATE=16000
STT_SAMPLE_RATE=16000

# STT config (Speech-to-Text)
STT_LANGUAGE=unknown      # "unknown" for auto-detect, or: en-IN, hi-IN, bn-IN, ta-IN, te-IN, etc.
STT_MODEL=saaras:v3       # Sarvam STT model (saaras:v3 recommended)

# TTS config (Text-to-Speech)
TTS_MODEL=bulbul:v3       # bulbul:v2, bulbul:v3, or bulbul:v3-beta
TTS_SPEAKER=ritu         # v3 speakers: aditya, ritu, priya, neha, rahul, pooja, rohan, simran, etc.
                          # v2 speakers: anushka, abhilash, manisha, vidya, arya, karun, hitesh
TTS_TARGET_LANGUAGE=en-IN # en-IN, hi-IN, bn-IN, ta-IN, te-IN, kn-IN, ml-IN, mr-IN, gu-IN, pa-IN, od-IN

# LLM config (Language Model)
LLM_MODEL=sarvam-30b        # sarvam-30b, sarvam-30b-16k, sarvam-105b, sarvam-105b-32k
LLM_TIMEOUT_MS=12000      # LLM request timeout in milliseconds

# Timezone
DEFAULT_TIMEZONE=Asia/Kolkata

TURN_DEBOUNCE_SECS=0.4
