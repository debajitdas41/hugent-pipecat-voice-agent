# ─────────────────────────────────────────────────────────────────────────────
# Backend .env — copy this file to .env and fill in values
#
# NOTE: DATABASE_URL, REDIS_HOST, REDIS_PORT, REDIS_PASSWORD are injected
#       directly by docker-compose — do NOT set them here, they will be
#       overridden by the compose environment block anyway.
# ─────────────────────────────────────────────────────────────────────────────

# App secret for QR token signing (generate any random 32-char hex string)
# Example: python3 -c "import secrets; print(secrets.token_hex(16))"
APP_SECRET=68af8838e6a0aecef0cbdb472887fed7

# Session TTLs (in seconds)
SESSION_TTL_SECONDS=30
SEEN_TTL_SECONDS=300
CALL_SESSION_TTL_SECONDS=600


